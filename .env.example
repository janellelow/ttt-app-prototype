# Copy this file to .env.local and fill in the values.
# These two are safe to ship in the app: the database rules decide what
# each person can see. NEVER put the service role key here.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: your mini app's Telegram link, used by "Share" buttons
# e.g. https://t.me/YourBot/app
VITE_TELEGRAM_APP_LINK=